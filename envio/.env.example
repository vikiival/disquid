# HyperSync API token: https://envio.dev/app/api-tokens
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"
# Ethereum RPC for token metadata (name/symbol/decimals via Multicall3 at
# `latest`; no archive node needed). Comma-separated for fallbacks. Defaults
# to public endpoints when unset.
# ENVIO_RPC_URL=https://your-ethereum-rpc
# Optional: stop at a fixed block (used for parity runs).
# ENVIO_END_BLOCK=
