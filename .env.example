DB_HOST=localhost
DB_PORT=5432
DB_NAME=squid
DB_USER=postgres
DB_PASS=postgres

# An Ethereum mainnet RPC provider with historical block reads.
RPC_URL=https://your-ethereum-rpc.example

# Optional RPC ingest limits. Tune to your provider's quota.
RPC_RATE_LIMIT=10
RPC_CAPACITY=10
RPC_STRIDE_SIZE=20
RPC_STRIDE_CONCURRENCY=1
